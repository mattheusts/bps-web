{
	admin off
	auto_https off
}

:{$PORT:8080} {
	handle /healthz {
		respond "ok" 200
	}

	handle /api/* {
		reverse_proxy {$API_URL} {
			header_up Host {upstream_hostport}
		}
	}

	handle {
		root * /srv
		encode zstd gzip
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
